# Copy to .env and edit. All values are optional — the compose file has safe
# defaults for everything except the LLM key (the server won't boot without one).

# --- LLM provider: set at least one. ---
# Local OpenAI-compatible endpoint (Ollama / vLLM / LM Studio / proxy).
# Note: Podman exposes the host as host.containers.internal; Docker uses
# host.docker.internal.
OPENAI_API_KEY=dummy
OPENAI_BASE_URL=http://host.containers.internal:20128/v1
OPENAI_MODEL=free-first

# --- Server ---
# Use a different host port if 6767 is already taken.
SUPERMEMORY_PORT=6767

# --- Embeddings (defaults are local CPU; uncomment to change) ---
# SUPERMEMORY_EMBEDDING_PROVIDER=local
# SUPERMEMORY_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5
# SUPERMEMORY_EMBEDDING_DIMENSIONS=768